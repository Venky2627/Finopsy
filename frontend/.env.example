# FINOPSY FRONTEND ENVIRONMENT CONFIGURATION

# Backend API URL (Points to production Render/Railway FastAPI URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & DB (Points to hosted Supabase Project URL & Anon Key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key
